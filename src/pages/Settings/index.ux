  width: 50px;
  height: 50px;
  border-radius: 25px;
  border: 3px solid #35a7ff;
  color: #35a7ff;
  font-size: 37px;
  line-height: 43px;
  text-align: center;
  opacity: active 0.62;
}

.setting-value {
  width: 82px;
