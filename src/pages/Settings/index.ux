  color: #35a7ff;
}

.color-swatch {
  width: 42px;
  height: 42px;
  margin-left: 6px;
  border-radius: 22px;
  border: 3px solid #35a7ff;
}

.color-value {
  width: 72px;
  color: #d8efff;
  font-size: 19px;
  line-height: 50px;
  text-align: center;
}

.swatch-warm {
  background-color: #f2eadb;
}

.swatch-white {
  background-color: #ffffff;
}

.swatch-aqua {
  background-color: #8ff1e7;
}

.swatch-yellow { background-color: #ffe28a; }
.swatch-blue { background-color: #8ecbff; }
.swatch-green { background-color: #b7eda8; }

.footer-item {
  width: 100%;
  padding: 5px 20px 18px 20px;
}

.footer-text {
  width: 100%;
  color: #627486;
  font-size: 18px;
  line-height: 28px;
  text-align: center;
}

@for $size from 10 through 50 {
  .font-#{$size} { font-size: #{$size}px; }

  @for $spacing from 3 through 30 {
    .font-#{$size}.line-#{$spacing} {
      line-height: #{$size * $spacing / 10}px;
    }
  }
}
.line-10 { line-height: 40px; }
.line-11 { line-height: 43px; }
.line-12 { line-height: 46px; }
.line-13 { line-height: 49px; }
.line-14 { line-height: 52px; }
