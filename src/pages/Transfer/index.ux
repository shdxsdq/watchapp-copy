<template>
  <div class="page">
    <div class="top-bar">
      <text class="back-button" onclick="goBack">‹</text>
      <text class="page-title">TXT 传书</text>
      <text class="header-spacer"></text>
    </div>
    <div class="transfer-card">
      <text class="transfer-title">等待接收 TXT</text>
      <text class="transfer-copy">在手机配套端选择 TXT 文件并发送，收到后会自动保存到离线书架。</text>
      <text class="transfer-badge">{{ transferStatus }}</text>
    </div>
    <text class="transfer-tip">仅支持 .txt 文件</text>
  </div>
</template>

<script>
import {
  getTxtTransferStatus,
  startTxtReceiver
} from '../../utils/txtLibrary.js'

export default {
  data: {
    transferStatus: '正在准备传书'
  },

  onInit() {
    startTxtReceiver()
    this.refreshStatus()
  },

  onShow() {
    this.refreshStatus()
  },

  refreshStatus() {
    this.transferStatus = getTxtTransferStatus()
  },

  goBack() {
    global.router.back()
  }
}
</script>

