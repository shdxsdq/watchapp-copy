  width: 100%;
  flex-direction: row;
  justify-content: flex-end;
}

.settings-button {
  width: 78px;
  height: 54px;
  border-radius: 27px;
  background-color: $surface;
  color: $paper;
  font-size: 21px;
  line-height: 54px;
  text-align: center;
  opacity: active 0.68;
}

.page-title {
  color: $paper;
  font-size: 44px;
  line-height: 56px;
  font-weight: bold;
}

.card-item {
  width: 100%;
  padding: 0 5px 10px 5px;
}

.card-row {
  width: 100%;
  height: 104px;
  flex-direction: row;
  align-items: center;
}

.article-card {
  width: 100%;
  height: 104px;
  padding: 10px 12px;
  border-radius: 16px;
  border: 1px solid #252b35;
  background-color: $surface;
  flex-direction: row;
  align-items: center;
  opacity: active 0.72;
}

.article-card-swiped {
  width: 120px;
}

.delete-action {
  width: 82px;
  height: 104px;
  margin-left: 8px;
  border-radius: 18px;
  background-color: #b93838;
  color: #ffffff;
  font-size: 22px;
  line-height: 104px;
  text-align: center;
  opacity: active 0.68;
}

.imported-card {
  border: 2px solid #245f89;
  background-color: #101b24;
}

.article-title {
  width: 100%;
  color: $paper;
  font-size: 23px;
  line-height: 31px;
  font-weight: bold;
  lines: 1;
}

.footer-item {
  width: 100%;
  height: 76px;
  flex-shrink: 0;
  padding: 8px 10px 22px 10px;
}

.footer-text {
  width: 100%;
